.venv/
.venv-llm/
__pycache__/
# data/: only the files the missions need are tracked (allow list, file by file) — the bot and experiments write many
# other files here while running (diag.json, dmglog*.json, char-state.json, routes/asylum-*.json …; ROADMAP P-5).
# A new file that must be shared: add a line below.
data/*
!data/burg-town-map.json
!data/climb-goal.json
!data/dsr-bonfires.txt
!data/enemy-map.json
!data/safe-zones.json
!data/spots.json
!data/routes/
data/routes/*
!data/routes/firelink-merchant-run.json
!data/routes/passage-merchant.json
!data/routes/user-climb.json
!data/routes/asylum-fresh.json
!data/gamefiles/
!data/samples/
*.out
*.err
*.log
.env
# labeling pilot (LAYA.md 11): scene manifest + labels are tracked, clips are rebuilt from the recordings (label_pilot.py build)
!data/labels/
data/labels/*
!data/labels/*_scenes.jsonl
!data/labels/*_labels.jsonl
!data/labels/*_reveals.jsonl
!data/labels/*_run_notes.jsonl
# Laya fine-tune results (small JSON); checkpoints stay in WSL ~/laya-ft
!data/laya/
data/laya/*
!data/laya/ft_*.json
!data/laya/pred_*.jsonl
!data/laya/boundary_selection.json

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "label-pilot",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "label_pilot.py",
        "serve"
      ],
      "port": 47811
    },
    {
      "name": "radar",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "radar_server.py"
      ],
      "port": 47801
    },
    {
      "name": "label-ramp",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "label_pilot.py",
        "serve",
        "--set",
        "ramp",
        "--port",
        "47814",
        "--review-bot"
      ],
      "port": 47814
    },
    {
      "name": "label-boundary",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "label_pilot.py",
        "serve",
        "--set",
        "boundary",
        "--port",
        "47815"
      ],
      "port": 47815
    }
  ]
}
